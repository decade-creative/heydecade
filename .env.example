# Salin file ini menjadi ".env" (jangan di-commit). Lihat README.md bagian "Aktifkan dashboard".
# Nilai-nilai di bawah dibuat otomatis oleh Keystatic saat kamu membuat GitHub App.

PUBLIC_KEYSTATIC_STORAGE=github
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
