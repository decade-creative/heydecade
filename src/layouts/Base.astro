---
interface Props {
  title: string;
  description?: string;
  image?: string;
}
const { title, description = '', image } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImage = image && Astro.site ? new URL(image, Astro.site).href : undefined;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{title}</title>
  {description && <meta name="description" content={description}>}
  {canonical && <link rel="canonical" href={canonical}>}
  <meta property="og:title" content={title}>
  {description && <meta property="og:description" content={description}>}
  {ogImage && <meta property="og:image" content={ogImage}>}
  <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'}>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;900&display=swap" rel="stylesheet">
</head>
<body>
  <slot />
</body>
</html>

<style is:global>
  :root{ --bg:#ffffff; --fg:#111111; --muted:#6b6b6b; --line:#dedcd7; --accent:#ff9029; --accent-ink:#1a1200; color-scheme:light; }
  @media (prefers-color-scheme: dark){ :root{ --bg:#0c0c0c; --fg:#f3f2ee; --muted:#9a9890; --line:#2a2a28; color-scheme:dark; } }
  *{box-sizing:border-box;}
  [hidden]{display:none !important;}
  body{ margin:0; background:var(--bg); color:var(--fg); font-family:'Archivo','Helvetica Neue',Arial,sans-serif; -webkit-font-smoothing:antialiased; }
  a{color:inherit;} :focus-visible{outline:2px solid var(--accent); outline-offset:3px;}

  header.hero{ padding:9vh 6vw 6vh; border-bottom:1px solid var(--line); }
  .eyebrow{ font-size:clamp(1rem, 1.6vw, 1.3rem); font-weight:500; color:var(--muted); margin:0 0 .6rem; }
  .name{ display:flex; flex-direction:column; width:100%; font-size:clamp(2.6rem, 14vw, 9rem); font-weight:900; line-height:0.92; letter-spacing:-0.02em; margin:0 0 1.1rem; text-transform:uppercase; }
  @media (min-width:641px){ .name{ flex-direction:row; justify-content:space-between; align-items:baseline; gap:2vw; } }
  .name span{ transition:color .25s ease; } .name span:hover{ color:var(--accent); }
  .tagline{ max-width:46ch; font-size:clamp(1rem,1.6vw,1.2rem); color:var(--muted); margin:0; line-height:1.5; }
  .tagline a{ text-decoration-color:var(--accent); text-underline-offset:3px; } .tagline a:hover{ color:var(--accent); }
  .topnav{ display:flex; gap:1.6rem; margin-top:2rem; font-size:.92rem; }
  .topnav a{ text-decoration:none; color:var(--muted); } .topnav a:hover{ color:var(--accent); }

  main{ padding:6vh 6vw 4vh; }
  section{ margin-bottom:10vh; scroll-margin-top:2rem; }
  .section-head{ display:flex; justify-content:space-between; align-items:flex-end; flex-wrap:wrap; gap:1rem; margin-bottom:2rem; }
  .section-head h2{ font-size:clamp(1.6rem,3vw,2.2rem); font-weight:900; margin:0; letter-spacing:-0.01em; }
  .section-sub{ color:var(--muted); font-size:.95rem; margin:.4rem 0 0; max-width:52ch; line-height:1.5; }
  .filters{ display:flex; flex-wrap:wrap; gap:.5rem; }
  .chip{ background:none; border:1px solid var(--line); color:var(--muted); padding:.4em .9em; font:inherit; font-size:.82rem; cursor:pointer; }
  .chip:hover{ border-color:var(--accent); color:var(--accent); }
  .chip.active{ background:var(--accent); border-color:var(--accent); color:var(--accent-ink); }
  .empty{ color:var(--muted); padding:1.5rem 0; }

  .gallery{ display:grid; grid-template-columns:repeat(3, 1fr); gap:2vw 1.5vw; }
  @media (max-width:980px){ .gallery{ grid-template-columns:repeat(2, 1fr); } }
  @media (max-width:560px){ .gallery{ grid-template-columns:1fr; gap:3rem; } }

  .card{ display:block; background:none; border:none; padding:0; text-align:left; font-family:inherit; color:inherit; cursor:pointer; width:100%; text-decoration:none; }
  .frame{ aspect-ratio:4/3; width:100%; background:var(--line); overflow:hidden; position:relative; transition:transform .4s cubic-bezier(.2,.8,.2,1); }
  .frame img{ position:absolute; inset:0; width:100%; height:100%; object-fit:cover; display:block; }
  .img-placeholder{ position:absolute; inset:0; display:flex; align-items:center; justify-content:center; color:var(--muted); font-size:.85rem; }
  .card:hover .frame{ transform:scale(1.035); }
  .overlay{ position:absolute; inset:0; display:flex; flex-direction:column; justify-content:flex-end; padding:1.1rem;
    background:linear-gradient(to top, rgba(0,0,0,.6), rgba(0,0,0,0) 65%); opacity:0; transform:translateY(10px); transition:opacity .35s ease, transform .35s ease; }
  .card:hover .overlay, .card:focus-visible .overlay{ opacity:1; transform:translateY(0); }
  .ov-title{ color:#fff; font-weight:700; font-size:1.05rem; }
  .ov-cat{ color:rgba(255,255,255,.78); font-size:.82rem; margin-top:.15rem; }
  .accent-bar{ position:absolute; left:0; bottom:0; height:3px; width:0; background:var(--accent); transition:width .4s ease; }
  .card:hover .accent-bar{ width:100%; }
  .card-meta{ margin-top:.7rem; }
  .card-meta .t{ font-weight:700; font-size:.98rem; }
  .card-meta .c{ color:var(--muted); font-size:.82rem; margin-top:.1rem; }
  /* Di layar sentuh tidak ada hover, jadi judul selalu terlihat di bawah kartu */
  .card-meta{ display:none; }
  @media (hover:none){ .card-meta{ display:block; } }

  .btn{ display:inline-block; border:1px solid var(--fg); background:none; color:var(--fg); padding:.75em 1.3em; font:inherit; font-size:.92rem; cursor:pointer; text-decoration:none; }
  .btn:hover{ background:var(--accent); border-color:var(--accent); color:var(--accent-ink); }
  .btn-solid{ background:var(--accent); border-color:var(--accent); color:var(--accent-ink); font-weight:600; }
  .btn-solid:hover{ opacity:.88; }

  .backdrop{ position:fixed; inset:0; background:rgba(0,0,0,.55); backdrop-filter:blur(6px); display:none; align-items:center; justify-content:center; padding:4vh 4vw; z-index:50; }
  .backdrop.open{ display:flex; }
  .modal{ background:var(--bg); color:var(--fg); width:min(760px, 100%); max-height:90vh; overflow-y:auto; border:1px solid var(--line); position:relative; }
  .modal-close{ position:absolute; top:.75rem; right:.9rem; background:var(--bg); border:1px solid var(--line); width:2.2rem; height:2.2rem; font-size:1.2rem; cursor:pointer; color:var(--fg); z-index:2; }
  .modal-close:hover{ background:var(--accent); border-color:var(--accent); color:var(--accent-ink); }
  .modal-frame{ aspect-ratio:4/3; width:100%; background:var(--line); overflow:hidden; position:relative; }
  .modal-frame img{ width:100%; height:100%; object-fit:cover; display:block; }
  .modal-body{ padding:1.75rem 1.75rem 0; }
  .modal-top{ display:flex; justify-content:space-between; align-items:flex-start; gap:1rem; }
  .modal-title{ font-size:1.6rem; font-weight:700; margin:0 0 .4rem; }
  .pill{ font-size:.78rem; color:var(--muted); border:1px solid var(--line); padding:.3em .7em; white-space:nowrap; }
  .modal-desc{ color:var(--muted); line-height:1.6; max-width:60ch; margin:1rem 0 1.5rem; white-space:pre-line; }
  .modal-nav{ display:flex; justify-content:space-between; align-items:center; border-top:1px solid var(--line); margin-top:1.75rem; padding:1rem 1.75rem; position:sticky; bottom:0; background:var(--bg); }
  .nav-btn{ background:none; border:none; font:inherit; font-size:.92rem; color:var(--muted); cursor:pointer; }
  .nav-btn:hover{ color:var(--accent); }
  .nav-count{ font-size:.8rem; color:var(--muted); }

  .contact{ border-top:1px solid var(--line); padding-top:3rem; }
  .contact h2{ font-size:clamp(1.6rem,3vw,2.2rem); font-weight:900; margin:0 0 .6rem; }
  .contact p{ color:var(--muted); max-width:46ch; line-height:1.5; margin:0 0 1.4rem; }
  .contact-actions{ display:flex; flex-wrap:wrap; gap:.8rem; }
  footer.site-footer{ padding:2rem 6vw 4rem; color:var(--muted); font-size:.82rem; }

  /* Halaman detail freebie */
  .detail{ max-width:900px; margin:0 auto; padding:5vh 6vw 8vh; }
  .back{ display:inline-block; margin-bottom:2rem; color:var(--muted); text-decoration:none; font-size:.92rem; }
  .back:hover{ color:var(--accent); }
  .detail .frame{ transition:none; }
  .detail .frame:hover{ transform:none; }
  .detail h1{ font-size:clamp(1.8rem,4vw,2.8rem); font-weight:900; margin:1.6rem 0 .5rem; letter-spacing:-0.01em; }
  .detail .desc{ color:var(--muted); line-height:1.7; max-width:60ch; white-space:pre-line; margin:1rem 0 1.6rem; }
  .license{ border:1px solid var(--line); padding:1rem 1.2rem; margin:0 0 1.8rem; max-width:60ch; }
  .license h3{ font-size:.78rem; text-transform:uppercase; letter-spacing:.05em; color:var(--muted); margin:0 0 .4rem; font-weight:600; }
  .license p{ margin:0; line-height:1.5; white-space:pre-line; font-size:.92rem; }
  .cta-box{ border-top:1px solid var(--line); margin-top:3rem; padding-top:2rem; }
  .cta-box h2{ font-size:1.3rem; font-weight:900; margin:0 0 .5rem; }
  .cta-box p{ color:var(--muted); margin:0 0 1.2rem; max-width:50ch; line-height:1.5; }
</style>
