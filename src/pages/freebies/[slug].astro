---
import Base from '../../layouts/Base.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../../keystatic.config';

export async function getStaticPaths() {
  const reader = createReader(process.cwd(), keystaticConfig);
  const all = await reader.collections.freebies.all();
  // Freebie yang tidak "Published" tidak dibuatkan halaman (entri lama tanpa tanda dianggap tayang)
  return all
    .filter(({ entry }) => entry.published !== false)
    .map(({ slug, entry }) => ({ params: { slug }, props: { entry } }));
}

const { entry } = Astro.props;

const reader = createReader(process.cwd(), keystaticConfig);
const settings = await reader.singletons.settings.read();
const siteName = settings?.siteName || 'Decade Studio';
const email = settings?.email || '';

// Ambil nama kategori dari daftar kategori freebies (kalau tidak ketemu, pakai teks aslinya)
const catEntry = entry.category ? await reader.collections.freebieCategories.read(entry.category) : null;
const categoryLabel = catEntry?.name || entry.category || '';

const description = entry.description || `Free ${categoryLabel.toLowerCase()} by ${siteName}.`;
const tags = (entry.tags ?? []).map((t) => t.trim()).filter(Boolean);
const hasSpecs = Boolean(entry.fileFormat || entry.fileSize || entry.software);

// Data terstruktur (JSON-LD) untuk halaman freebie
const siteUrl = (Astro.site ?? new URL('https://heydecade.com')).href.replace(/\/$/, '');
const pageUrl = `${siteUrl}/freebies/${Astro.params.slug}`;
const imageUrl = entry.image ? new URL(entry.image, `${siteUrl}/`).href : undefined;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: entry.title,
  description,
  url: pageUrl,
  image: imageUrl,
  genre: categoryLabel || undefined,
  keywords: tags.length ? tags.join(', ') : undefined,
  isAccessibleForFree: true,
  creator: { '@type': 'Organization', name: siteName, url: siteUrl },
};
const jsonLdString = JSON.stringify(jsonLd).replace(/</g, '\\u003c');
---
<Base title={`${entry.title} — Free ${categoryLabel} | ${siteName}`} description={description} image={entry.image}>
  <div class="detail">
    <a class="back" href="/#freebies">← All free assets</a>

    <div class="frame">
      {entry.image
        ? <img src={entry.image} alt={entry.imageAlt || `${entry.title}, ${categoryLabel}`} width="1200" height="900" fetchpriority="high" decoding="async">
        : <div class="img-placeholder">Image</div>}
    </div>

    <h1>{entry.title}</h1>
    <span class="pill">{categoryLabel}</span>

    {entry.description && <p class="desc">{entry.description}</p>}

    {hasSpecs && (
      <dl class="specs">
        {entry.fileFormat && <div><dt>Format</dt><dd>{entry.fileFormat}</dd></div>}
        {entry.fileSize && <div><dt>File size</dt><dd>{entry.fileSize}</dd></div>}
        {entry.software && <div><dt>Works with</dt><dd>{entry.software}</dd></div>}
      </dl>
    )}

    {tags.length > 0 && (
      <ul class="tags">
        {tags.map((t) => <li>{t}</li>)}
      </ul>
    )}

    {entry.license && (
      <div class="license">
        <h3>License</h3>
        <p>{entry.license}</p>
      </div>
    )}

    <a class="btn btn-solid" href={entry.gumroadUrl} target="_blank" rel="noopener">Download free</a>

    <div class="cta-box">
      <h2>Need something custom?</h2>
      <p>I design illustrations, apparel, packaging, and brand identities. Let's talk about your project.</p>
      <div class="contact-actions">
        {email && <a class="btn btn-solid" href={`mailto:${email}`}>Get in touch</a>}
        <a class="btn" href="/#work">See my portfolio</a>
      </div>
    </div>
  </div>
  <script type="application/ld+json" set:html={jsonLdString}></script>
</Base>

<style>
  .specs{ display:flex; flex-wrap:wrap; gap:1.2rem 2.5rem; margin:0 0 1.4rem; padding:1rem 0; border-top:1px solid var(--line); border-bottom:1px solid var(--line); max-width:60ch; }
  .specs dt{ font-size:.72rem; text-transform:uppercase; letter-spacing:.05em; color:var(--muted); font-weight:600; margin:0 0 .25rem; }
  .specs dd{ margin:0; font-weight:600; }
  .tags{ list-style:none; display:flex; flex-wrap:wrap; gap:.5rem; padding:0; margin:0 0 1.8rem; }
  .tags li{ border:1px solid var(--line); color:var(--muted); font-size:.82rem; padding:.3em .8em; }
</style>
